#!/bin/sh

# 1. Load the cursor size settings immediately to prevent giant icons
if [ -f ~/.Xresources ]; then
    xrdb -merge ~/.Xresources
fi

# Get monitor status
# We grep for " connected" to ensure we don't match "disconnected" lines
DP18_CONNECTED=$(xrandr | grep "DP-1-8 connected")
DP11_CONNECTED=$(xrandr | grep "DP-1-1 connected")

# Get Lid Status
# Returns "closed" or "open". The wildcard * handles different ACPI paths.
LID_STATE=$(grep -o "closed" /proc/acpi/button/lid/*/state 2>/dev/null || echo "open")

# --- Logic Tree ---

if [ -n "$DP18_CONNECTED" ] && [ -n "$DP11_CONNECTED" ]; then
    # BOTH EXTERNAL MONITORS ARE CONNECTED

    if [ "$LID_STATE" = "closed" ]; then
        # ---------------------------------------------------------
        # SCENARIO 3: CLAMSHELL MODE (Lid Closed)
        # Laptop screen OFF.
        # DP-1-1 (Bottom) is PRIMARY.
        # Monitors moved to 0x0 because laptop is gone.
        # --dpi 96 forces standard scaling.
        # ---------------------------------------------------------
        xrandr --output eDP-1 --off \
               --output DP-2 --off \
               --output DP-1-8 --mode 1920x1080 --pos 0x0 --rotate normal \
               --output DP-1-1 --primary --mode 1920x1080 --pos 0x1080 --rotate normal \
               --dpi 96
    else
        # ---------------------------------------------------------
        # SCENARIO 2: WORKSTATION MODE (Lid Open)
        # Laptop screen ON (Centered vertically relative to stack).
        # Stack pushed right to 2048x0.
        # --dpi 96 forces standard scaling.
        # ---------------------------------------------------------
        xrandr --output eDP-1 --primary --mode 2048x1152 --pos 0x504 --rotate normal \
               --output DP-2 --off \
               --output DP-1-8 --mode 1920x1080 --pos 2048x0 --rotate normal \
               --output DP-1-1 --mode 1920x1080 --pos 2048x1080 --rotate normal \
               --dpi 96
    fi

else
    # ---------------------------------------------------------
    # SCENARIO 1: LAPTOP MODE (No External Monitors)
    # Only Laptop screen is on.
    # ---------------------------------------------------------
    xrandr --output eDP-1 --primary --mode 2048x1152 --pos 0x0 --rotate normal \
           --output DP-2 --off \
           --output DP-1-8 --off \
           --output DP-1-1 --off
fi

# 2. Force the pointer to reset to the standard 'left_ptr' arrow.
# This fixes the issue where the cursor disappears or turns into an 'X'
xsetroot -cursor_name left_ptr

# 3. Restore Wallpaper (Uncomment your preferred tool)
# nitrogen --restore &
# feh --bg-fill /path/to/wallpaper.jpg &
#feh --bg-scale ~/wallpaper/pfback-titles.jpg &
feh --bg-scale ~/wallpaper/sein-river.jpg &
